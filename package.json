{
  "dependencies": {
    "linkinator": "8.1.0",
    "marked": "18.1.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "name": "html-skeleton",
  "private": true,
  "scripts": {
    "test:links": "node --test tests/link-validation.test.mjs",
    "validate": "node scripts/validate.mjs",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:html": "html-validate \"site/**/*.html\"",
    "check:css": "stylelint \"site/**/*.css\"",
    "check:js": "eslint . --max-warnings=0",
    "build:distribution": "node scripts/build-distribution.mjs",
    "test:baseline": "node --test --test-concurrency=1 tests/baseline.test.mjs tests/source-boundary.test.mjs",
    "check:source-boundary": "node scripts/check-source-boundary.mjs",
    "check:site-links": "node scripts/check-site-links.mjs"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "html-validate": "11.17.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  },
  "version": "0.1.0"
}
